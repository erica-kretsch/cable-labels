<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="Main.props"/>
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <!--
      Also the name of the Unity assembly definition (src/Assets/CableLabels/CableLabels.asmdef).
      Prefabs in the asset bundle find their components by assembly, namespace and class name,
      so this DLL and Unity's compile of the same sources must agree on all three.
    -->
    <AssemblyName>CableLabels</AssemblyName>
    <Description>Thin labels for cables, like the vanilla pipe label.</Description>
    <!-- The shipped build. Unity's editor compile of the same sources doesn't define it. -->
    <DefineConstants>$(DefineConstants);CL_GAME</DefineConstants>
    <!-- The sources live in the Unity project; nothing else under src/ is ours to compile. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);src/**</DefaultItemExcludes>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <!-- From the LaunchPad install beside the game; CI passes one from a LaunchPad release. -->
    <LaunchPadBoosterDll Condition="'$(LaunchPadBoosterDll)' == ''">$(StationeersDllDir)/../../BepInEx/plugins/StationeersLaunchPad/LaunchPadBooster.dll</LaunchPadBoosterDll>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/Assets/CableLabels/**/*.cs"/>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all"/>
    <PackageReference Include="BepInEx.Core" Version="5.*"/>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all"/>
    <PackageReference Include="UnityEngine.Modules" Version="2021.2.3" IncludeAssets="compile"/>
    <!-- Publicize Assembly-CSharp so CableLabel can share Label's private draw lock. -->
    <PackageReference Include="Krafs.Publicizer" Version="2.3.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <Publicize Include="Assembly-CSharp"/>
  </ItemGroup>
  <!-- Game DLLs, from StationeersDllDir (see Main.props). -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(StationeersDllDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(StationeersDllDir)/Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(StationeersDllDir)/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UniTask">
      <HintPath>$(StationeersDllDir)/UniTask.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(StationeersDllDir)/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="netstandard">
      <HintPath>$(StationeersDllDir)/netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- LaunchPad's helper library, for registering the asset bundle's prefab. -->
    <Reference Include="LaunchPadBooster">
      <HintPath>$(LaunchPadBoosterDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
